# Local dev notes — not for repo
NOTES.md

# The React Native app is its own git repo (onecarbon_app/.git) — this repo is
# the website and is served by GitHub Pages, so app source and node_modules
# must not land in it. Push the app from inside onecarbon_app/.
onecarbon_app/

# Large video files — hosted on Cloudflare R2, not in git
media/*.mp4
media/*.webm

# Graphify output — local analysis only
graphify-out/
js/graphify-out/

# Claude Code local tooling
.claude/

# macOS metadata
.DS_Store
**/.DS_Store

# Local scratch / old format files
old formatOur Story.html

# Firestore exports — real people's contact details, keep them out of git
exports/

# Service account keys — full admin access to the Firebase project
*serviceaccount*.json
*-key.json
onecarbon-app-*.json
