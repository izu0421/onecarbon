rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Form submissions are written only by the submitForm Cloud Function,
    // which uses the Admin SDK and bypasses these rules. No client access.
    match /submissions/{formId}/entries/{entryId} {
      allow read, write: if false;
    }

    // Recursive wildcard: rules do NOT cascade into subcollections on their
    // own, and the app stores data under users/{uid}/profile/data and
    // users/{uid}/sessions/{id}. Matching {document=**} covers the user doc
    // and every subcollection under it — a user still only ever reaches
    // their own tree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
